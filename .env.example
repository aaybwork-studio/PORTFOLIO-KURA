# Sanity project id. Leave empty to run the site on local fallback content
# (the design's placeholder copy in src/lib/fallback.ts). The embedded Studio
# at /studio also stays disabled while this is empty.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Sanity dataset name.
NEXT_PUBLIC_SANITY_DATASET=production

# Optional read token, only needed for private datasets / drafts.
SANITY_API_READ_TOKEN=
